[sub_resource type="GDScript" id="GDScript_nor4k"]
script/source = "class_name NewBugVisual
extends Node2D

const DIRECTION_COUNT: int = 8
const DIRECTION_VECTORS: Array[Vector2] = [Vector2(0, 1), Vector2(-0.7071, 0.7071), Vector2(-1, 0), Vector2(-0.7071, -0.7071), Vector2(0, -1), Vector2(0.7071, -0.7071), Vector2(1, 0), Vector2(0.7071, 0.7071)]
const BUG_TEXTURES: Array[Texture2D] = [
	preload(\"res://assets/generated/bug_0_s.png\"), preload(\"res://assets/generated/bug_1_sw.png\"),
	preload(\"res://assets/generated/bug_2_w.png\"), preload(\"res://assets/generated/bug_3_nw.png\"),
	preload(\"res://assets/generated/bug_4_n.png\"), preload(\"res://assets/generated/bug_5_ne.png\"),
	preload(\"res://assets/generated/bug_6_e.png\"), preload(\"res://assets/generated/bug_7_se.png\"),
]

@export_group(\"Размер\")
## Высота купола жука на экране, в px; увеличение делает жука крупнее.
@export var bug_visual_height_px: float = 36.0:
	set(value):
		bug_visual_height_px = value
		if is_node_ready(): _apply_visual_scale()
## Доля высоты изображения, занятая куполом; увеличение уменьшает общий масштаб тела.
@export_range(0.5, 1.0, 0.01) var dome_height_fraction: float = 0.8

@export_group(\"Заземление\")
## Смещение тела вниз от линии лап, px; увеличение сильнее прижимает жука к тени.
@export var ground_offset_px: float = 3.0
## Ширина тени относительно корпуса, доля; увеличение расширяет тень.
@export_range(0.5, 1.5, 0.01) var shadow_width_fraction: float = 0.9
## Непрозрачность тени, доля 0–1; увеличение делает тень темнее.
@export_range(0.0, 1.0, 0.01) var shadow_opacity: float = 0.5
## Смещение центра тени от линии лап, px; увеличение сдвигает тень вправо и вниз.
@export var shadow_offset: Vector2 = Vector2(3.0, 2.0)

@export_group(\"Направление\")
## Время сглаживания вектора движения, секунды; увеличение делает поворот плавнее.
@export var smoothing_duration: float = 0.15
## Угол гистерезиса смены направления, градусы; увеличение уменьшает дрожание поворота.
@export_range(0.0, 45.0, 0.5) var direction_hysteresis_degrees: float = 10.0

@export_group(\"Походка\")
## Амплитуда покачивания по Y, px; увеличение усиливает покачивание.
@export var bob_amplitude_px: float = 2.5
## Амплитуда наклона, градусы; увеличение делает шаги заметнее.
@export var tilt_degrees: float = 3.5
## Сжатие по высоте при приземлении, доля; увеличение усиливает squash.
@export var landing_squash_percent: float = 0.025
## Толчок вперёд на шаге, px; увеличение удлиняет визуальный шаг.
@export var step_forward_px: float = 1.5
## Частота шагов на единицу скорости; увеличение ускоряет походку.
@export var step_frequency_at_speed: float = 0.16
## Минимальная скорость для походки, px/с; увеличение дольше оставляет жука в покое.
@export var minimum_step_speed: float = 8.0

@export_group(\"Пыль\")
## Число частиц пыли в пуле; увеличение даёт больше частиц на шагах.
@export var dust_count: int = 3
## Время жизни пылинки, секунды; увеличение оставляет пыль дольше.
@export var dust_lifetime: float = 0.2
## Горизонтальный разлёт пыли, px; увеличение расширяет облачко.
@export var dust_spread_px: float = 5.0
## Скорость подъёма пыли, px/с; увеличение поднимает её выше.
@export var dust_rise_px: float = 4.0
## Цвет и базовая прозрачность пыли; увеличение альфы делает её заметнее.
@export var dust_color: Color = Color(0.73, 0.42, 0.24, 0.72)

@export_group(\"Попадание\")
## Длительность вспышки попадания, секунды; увеличение растягивает эффект.
@export var flash_duration: float = 0.07
## Сила белой вспышки; увеличение делает попадание ярче.
@export var flash_strength: float = 0.8
## Затемнение нижних 20% спрайта, доля; увеличение сильнее вживляет низ в землю.
@export_range(0.0, 1.0, 0.01) var bottom_shade_strength: float = 0.35
## Минимальный интервал между вспышками, секунды; увеличение подавляет частые вспышки.
@export var hit_min_interval: float = 0.05
## Амплитуда дрожи спрайта, px; увеличение усиливает встряску.
@export var hit_jitter_px: float = 1.5

@onready var body: Sprite2D = $Body
@onready var contact_shadow: Sprite2D = $ContactShadow
@onready var contact_shadow_material: ShaderMaterial = contact_shadow.material as ShaderMaterial

var current_direction: int = 0
var smoothed_velocity: Vector2 = Vector2.DOWN
var gait_phase: float = 0.0
var previous_step_phase: float = 0.0
var random_phase: float = 0.0
var last_hit_time: float = -INF
var hit_tween: Tween
var dust_nodes: Array[Polygon2D] = []
var dust_positions: Array[Vector2] = []
var dust_velocities: Array[Vector2] = []
var dust_remaining: Array[float] = []
var dust_cursor: int = 0
var body_base_position: Vector2 = Vector2.ZERO
var body_rest_position: Vector2 = Vector2.ZERO
var body_rest_scale: Vector2 = Vector2.ONE

func _ready() -> void:
	body_base_position = body.position
	body_rest_position = body_base_position + Vector2(0.0, ground_offset_px)
	body_rest_scale = body.scale
	random_phase = randf_range(0.0, TAU)
	gait_phase = random_phase
	previous_step_phase = gait_phase
	_apply_visual_scale()
	_apply_grounding()
	for child: Node in get_children():
		if child is Polygon2D and child.name.begins_with(\"Dust\"):
			dust_nodes.append(child as Polygon2D)
			dust_positions.append(Vector2.ZERO)
			dust_velocities.append(Vector2.ZERO)
			dust_remaining.append(0.0)
	_set_direction(0)

func _process(delta: float) -> void:
	var bug: GrayboxBug = get_parent() as GrayboxBug
	if not is_instance_valid(bug):
		return
	var speed_now: float = bug.velocity.length() / bug.map_scale()
	if speed_now > 0.1:
		smoothed_velocity = smoothed_velocity.lerp(bug.velocity, clampf(delta / maxf(smoothing_duration, 0.001), 0.0, 1.0))
		_update_direction(smoothed_velocity)
	var movement_ratio: float = clampf(speed_now / maxf(bug.speed, 1.0), 0.0, 1.5)
	if speed_now >= minimum_step_speed:
		gait_phase = fposmod(gait_phase + delta * speed_now * step_frequency_at_speed, TAU)
		if _crossed_step(previous_step_phase, gait_phase):
			_emit_dust()
		previous_step_phase = gait_phase
	else:
		gait_phase = fposmod(gait_phase + delta * 1.2, TAU)
	_animate_body(gait_phase, movement_ratio, speed_now >= minimum_step_speed)
	_update_dust(delta)

func _apply_visual_scale() -> void:
	var content_height: float = 100.0
	body.scale = Vector2.ONE * bug_visual_height_px / maxf(content_height * dome_height_fraction, 1.0)
	body_rest_scale = body.scale
	_apply_grounding()

func _apply_grounding() -> void:
	body_rest_position = body_base_position + Vector2(0.0, ground_offset_px)
	body.position = body_rest_position
	var used_rect: Rect2i = body.texture.get_image().get_used_rect() if body.texture != null else Rect2i(0, 0, 100, 100)
	var body_width_px: float = float(used_rect.size.x) * body.scale.x
	var shadow_width_px: float = body_width_px * shadow_width_fraction
	var shadow_height_px: float = shadow_width_px * 0.4
	var shadow_texture_size: Vector2 = contact_shadow.texture.get_size() if contact_shadow.texture != null else Vector2(128.0, 64.0)
	contact_shadow.scale = Vector2(shadow_width_px / maxf(shadow_texture_size.x, 1.0), shadow_height_px / maxf(shadow_texture_size.y, 1.0))
	contact_shadow.position = body_base_position + shadow_offset
	contact_shadow.rotation = 0.0
	if contact_shadow_material != null:
		contact_shadow_material.set_shader_parameter(\"shadow_opacity\", shadow_opacity)
	var body_material: ShaderMaterial = body.material as ShaderMaterial
	if body_material != null:
		body_material.set_shader_parameter(\"bottom_shade_strength\", bottom_shade_strength)

func _update_direction(vector: Vector2) -> void:
	if vector.length_squared() <= 0.01:
		return
	var angle: float = atan2(vector.x, vector.y)
	var desired: int = posmod(roundi(-angle / (PI / 4.0)), DIRECTION_COUNT)
	var current_vector: Vector2 = DIRECTION_VECTORS[current_direction]
	var angular_distance: float = absf(angle_difference(atan2(current_vector.x, current_vector.y), angle))
	if desired != current_direction and angular_distance >= deg_to_rad(22.5 + direction_hysteresis_degrees):
		_set_direction(desired)

func _set_direction(index: int) -> void:
	current_direction = posmod(index, DIRECTION_COUNT)
	body.texture = BUG_TEXTURES[current_direction]
	_apply_grounding()

func _animate_body(phase: float, movement_ratio: float, walking: bool) -> void:
	var bob: float = maxf(sin(phase * 2.0), 0.0) * bob_amplitude_px * clampf(movement_ratio, 0.35, 1.0)
	var step_push: float = maxf(sin(phase), 0.0) * step_forward_px if walking else 0.0
	var squash: float = 1.0 - maxf(sin(phase * 2.0), 0.0) * landing_squash_percent if walking else 1.0
	body.position = body_rest_position + Vector2(0.0, bob + step_push)
	body.rotation = sin(phase) * deg_to_rad(tilt_degrees) * clampf(movement_ratio, 0.0, 1.0)
	body.scale = Vector2(body_rest_scale.x / maxf(squash, 0.001), body_rest_scale.y * squash)
	contact_shadow.position = body_base_position + shadow_offset
	contact_shadow.rotation = 0.0

func _crossed_step(old_phase: float, new_phase: float) -> bool:
	return new_phase < old_phase or (old_phase < PI and new_phase >= PI)

func _emit_dust() -> void:
	if dust_nodes.is_empty():
		return
	var index: int = dust_cursor % dust_nodes.size()
	dust_cursor += 1
	var node: Polygon2D = dust_nodes[index]
	var side: float = -1.0 if index % 2 == 0 else 1.0
	dust_positions[index] = Vector2(side * randf_range(0.0, dust_spread_px), 8.0)
	dust_velocities[index] = Vector2(side * randf_range(2.0, 8.0), -dust_rise_px)
	dust_remaining[index] = dust_lifetime
	node.position = dust_positions[index]
	node.modulate = dust_color
	node.visible = true

func _update_dust(delta: float) -> void:
	for index: int in dust_nodes.size():
		if dust_remaining[index] <= 0.0:
			continue
		dust_remaining[index] -= delta
		dust_positions[index] += dust_velocities[index] * delta
		dust_velocities[index].y += 10.0 * delta
		dust_nodes[index].position = dust_positions[index]
		dust_nodes[index].modulate.a = maxf(dust_remaining[index] / maxf(dust_lifetime, 0.001), 0.0) * dust_color.a
		if dust_remaining[index] <= 0.0:
			dust_nodes[index].visible = false

func on_hit() -> void:
	var now: float = Time.get_ticks_msec() / 1000.0
	if now - last_hit_time < hit_min_interval:
		return
	last_hit_time = now
	if hit_tween != null and hit_tween.is_valid():
		hit_tween.kill()
	body.position = body_rest_position
	var hit_material: ShaderMaterial = body.material as ShaderMaterial
	if hit_material != null:
		hit_material.set_shader_parameter(\"flash_strength\", flash_strength)
		hit_material.set_shader_parameter(\"hit_flash\", 1.0)
	hit_tween = create_tween()
	hit_tween.set_parallel(true)
	hit_tween.tween_property(body, \"position:x\", body_rest_position.x + randf_range(-hit_jitter_px, hit_jitter_px), flash_duration * 0.5)
	hit_tween.tween_property(body, \"position:y\", body_rest_position.y + randf_range(-hit_jitter_px, hit_jitter_px), flash_duration * 0.5)
	hit_tween.chain().tween_property(body, \"position\", body_rest_position, flash_duration * 0.5)
	if hit_material != null:
		hit_tween.parallel().tween_method(_set_hit_flash.bind(hit_material), 1.0, 0.0, flash_duration)

func _set_hit_flash(value: float, shader_material: ShaderMaterial) -> void:
	if is_instance_valid(shader_material):
		shader_material.set_shader_parameter(\"hit_flash\", value)
"

